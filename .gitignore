# 虚拟环境（几百 MB，不进仓库）
.venv/

# Python 缓存
__pycache__/
*.py[cod]
*.pyd

# 本地配置与个人素材：只保留在磁盘，不跟踪
config.yaml
models/
persona/

# 运行态：记忆库、播出记录、加密的 key、下载的识别模型
#   state/asr/       SenseVoice 等 sherpa 模型（约 240 MB 起）
state/

# 临时排查产物（截图、日志、一次性脚本输出）
temp/

# 兜底：这几类文件永远不是源码，出现在别处也别提交
*.onnx
*.moc3

# 日志
*.log

# 编辑器 / 系统
# 合并/编辑残留
*.bak
*.orig
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
